<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only apps signed with the same key as this plugin (IRIDIS) may run commands. -->
    <permission
        android:name="com.iridis.terminal.permission.RUN_COMMAND"
        android:label="@string/perm_label"
        android:description="@string/perm_desc"
        android:protectionLevel="signature" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The shared workspace Download/IRIDIS/workspace is written by IRIDIS too. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />

    <queries>
        <package android:name="com.iridis" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_terminal"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.DayNight"
        tools:ignore="DataExtractionRules">

        <activity
            android:name=".TerminalActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- run_command for IRIDIS: ContentResolver.call("com.iridis.terminal.run", "run_command", …).
             Every call is checked: the caller must hold RUN_COMMAND (signature) or share our signer. -->
        <provider
            android:name=".CommandProvider"
            android:authorities="com.iridis.terminal.run"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
    </application>
</manifest>
