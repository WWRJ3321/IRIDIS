# 2.7.0: cross toolchain for an aarch64 Linux host (NDK's clang is x86_64-only): host clang-19/lld-19 + NDK r27c sysroot.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(ANDROID TRUE)
set(NDK_SYSROOT "$ENV{NDK}/toolchains/llvm/prebuilt/linux-x86_64/sysroot")
set(CMAKE_SYSROOT ${NDK_SYSROOT})
set(CMAKE_C_COMPILER clang-19)
set(CMAKE_CXX_COMPILER clang++-19)
set(CMAKE_C_COMPILER_TARGET aarch64-linux-android31)
set(CMAKE_CXX_COMPILER_TARGET aarch64-linux-android31)
set(CMAKE_AR llvm-ar-19)
set(CMAKE_RANLIB llvm-ranlib-19)
set(CMAKE_STRIP llvm-strip-19)
set(CMAKE_C_FLAGS_INIT "--rtlib=compiler-rt --unwindlib=libunwind -fPIC -ffunction-sections -fdata-sections")
set(CMAKE_CXX_FLAGS_INIT "--rtlib=compiler-rt --unwindlib=libunwind -fPIC -ffunction-sections -fdata-sections -stdlib=libc++")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld-19 -static-libstdc++ -Wl,--build-id=sha1 -Wl,--no-undefined")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld-19 -static-libstdc++")
set(CMAKE_FIND_ROOT_PATH ${NDK_SYSROOT})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
